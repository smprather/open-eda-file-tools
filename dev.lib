/* Synthetic development library. All cell names and values are illustrative. */

library (dev) {
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit (1, pf);

  lu_table_template (dev_delay) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.01, 0.04");
    index_2 ("0.001, 0.004");
  }

  power_lut_template (dev_power) {
    variable_1 : input_transition_time;
    index_1 ("0.01, 0.04");
  }

  output_current_template (dev_current) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    variable_3 : time;
    index_1 ("0.01");
    index_2 ("0.001");
    index_3 ("0, 0.02, 0.04");
  }

  cell (DevBuffer) {
    area : 1.1;
    pin (A) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Y) {
      direction : output;
      function : "A";
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise (dev_delay) { values ("0.020, 0.037", "0.029, 0.047"); }
        cell_fall (dev_delay) { values ("0.017, 0.033", "0.025, 0.042"); }
        rise_transition (dev_delay) { values ("0.010, 0.019", "0.014, 0.029"); }
        fall_transition (dev_delay) { values ("0.008, 0.017", "0.012, 0.025"); }
        output_current_rise () {
          vector (dev_current) {
            reference_time : 0;
            index_1 ("0.01");
            index_2 ("0.001");
            index_3 ("0, 0.02, 0.04");
            values ("0, 0.3, 0");
          }
        }
      }
      internal_power () {
        related_pin : "A";
        rise_power (dev_power) { values ("0.002, 0.003"); }
        fall_power (dev_power) { values ("0.003, 0.004"); }
      }
    }
  }

  cell (DevFlipFlop) {
    area : 2.8;
    ff (IQ, IQN) {
      clocked_on : "CLK";
      next_state : "D";
    }
    pg_pin (VDD) { pg_type : primary_power; }
    pg_pin (VSS) { pg_type : primary_ground; }
    pin (CLK) {
      direction : input;
      clock : true;
      capacitance : 0.002;
    }
    pin (D) {
      direction : input;
      capacitance : 0.001;
    }
    pin (QN) {
      direction : output;
      function : "IQN";
      power_down_function : "(!VDD) + VSS";
      timing () {
        related_pin : "CLK";
        timing_type : rising_edge;
        timing_sense : non_unate;
        cell_rise (dev_delay) { values ("0.040, 0.059", "0.052, 0.071"); }
        cell_fall (dev_delay) { values ("0.038, 0.054", "0.049, 0.065"); }
      }
    }
  }
}
